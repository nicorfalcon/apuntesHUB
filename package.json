{
  "name": "apunteshub",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @apunteshub/web",
    "build": "npm run build -w @apunteshub/web",
    "start": "npm run start -w @apunteshub/web",
    "lint": "npm run lint -w @apunteshub/web",
    "test": "npm run test -w @apunteshub/web",
    "test:e2e": "npm run test:e2e -w @apunteshub/web",
    "hls:convert": "node apps/web/scripts/convert-course-video-hls.mjs",
    "hls:process-pending": "node apps/web/scripts/process-pending-hls.mjs",
    "search:reindex": "node apps/web/scripts/reindex-search.mjs",
    "preview:process-pending": "node apps/web/scripts/process-pending-previews.mjs",
    "preview:backfill": "node apps/web/scripts/enqueue-preview-backfill.mjs",
    "preview:cleanup": "node apps/web/scripts/cleanup-orphan-previews.mjs"
  },
  "devDependencies": {
    "supabase": "^2.98.0",
    "vitest": "^4.1.7"
  }
}
