# Variables de entorno para la integración de PayPal Commerce Platform (Multiparty).
# Copiá estas líneas a tu .env.local y completá con las credenciales de tu app de PayPal.
#
# En SANDBOX: developer.paypal.com → Apps & Credentials → Sandbox → tu app REST.
# En PRODUCCIÓN: requiere que PayPal apruebe tu plataforma (formulario Multiparty).

# sandbox | live
PAYPAL_ENV=sandbox

# Credenciales de la app REST (partner/plataforma)
PAYPAL_PARTNER_CLIENT_ID=
PAYPAL_PARTNER_CLIENT_SECRET=

# Merchant/Payer ID de TU cuenta PayPal Business (payee que recibe el platform_fee).
PAYPAL_PARTNER_MERCHANT_ID=

# BN Code / attribution id de partner (opcional pero recomendado por PayPal).
PAYPAL_BN_CODE=

# Webhook ID creado en el dashboard, apuntando a /api/webhooks/paypal.
PAYPAL_WEBHOOK_ID=
