# Meilisearch — PoC de búsqueda pública (browse). Copiar estas claves a tu
# .env.local (no versionar secretos). Todas son server-side: NUNCA exponer al
# frontend (no usar prefijo NEXT_PUBLIC_).

# Host del servidor Meilisearch (ej: http://localhost:7700 o tu instancia cloud).
MEILISEARCH_HOST=
# API key con permisos de búsqueda + indexación (search/admin). Server-only.
MEILISEARCH_API_KEY=
# Nombre del índice de apuntes. Default: resumes
MEILISEARCH_RESUMES_INDEX=resumes
# Feature flag de LECTURA: si != "true", el browse usa Postgres (comportamiento
# actual intacto). La indexación funciona apenas hay HOST+API_KEY, aunque el
# flag esté en false, para poder poblar el índice antes de activarlo.
ENABLE_MEILISEARCH_BROWSE=false
# Secret bearer para el endpoint admin de reindexado masivo
# (POST /api/admin/search/reindex { action: "reindex-all" }) y el script
# `npm run search:reindex`.
MEILISEARCH_ADMIN_SECRET=
